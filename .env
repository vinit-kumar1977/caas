# =====================================================
# APPLICATION
# =====================================================
APP_NAME=CAAS
APP_ENV=development
APP_PORT=3000
APP_PREFIX=/api/v1

# =====================================================
# PRIMARY POSTGRESQL DATABASE
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caas_db
DB_USER=postgres
DB_PASS=123456

DB_SCHEMA=public
DB_SSL=false

# Connection pool
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# Database reliability
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY=3000
DB_SYNCHRONIZE=false
DB_LOGGING=false

# =====================================================
# POSTGRESQL READ REPLICA
# =====================================================
DB_REPLICA_ENABLED=false
DB_REPLICA_HOST=
DB_REPLICA_PORT=5432
DB_REPLICA_NAME=caas
DB_REPLICA_USER=
DB_REPLICA_PASS=
DB_REPLICA_SSL=false

# =====================================================
# REDIS
# =====================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_MAX_RETRIES=3
REDIS_KEY_PREFIX=caas:

# =====================================================
# REDIS CACHE
# =====================================================
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_MAX_ITEMS=10000

# =====================================================
# AUTHENTICATION
# =====================================================
JWT_ALGORITHM=EdDSA
JWT_ACCESS_TOKEN_EXPIRES_IN=180
JWT_REFRESH_TOKEN_EXPIRES_IN=604800 //7 days
JWT_ISSUER=caas
JWT_AUDIENCE=caas-api
JWT_PRIVATE_KEY=./secrets/private.pem
JWT_PUBLIC_KEY=./secrets/public.pem

PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_PARALLELISM=1

# =====================================================
# SECURITY
# =====================================================
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=900

SESSION_MAX_DEVICES=5
SESSION_IDLE_TIMEOUT=1800

# =====================================================
# KAFKA
# =====================================================
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=caas
KAFKA_GROUP_ID=caas-consumers

# =====================================================
# BACKGROUND JOBS
# =====================================================
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=10
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_DELAY=3000

# =====================================================
# EMAIL
# =====================================================
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# =====================================================
# FILE UPLOAD
# =====================================================
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=10

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=info
LOG_PRETTY=true
LOG_REQUEST_ID=true

# =====================================================
# MONITORING
# =====================================================
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true

# =====================================================
# SHUTDOWN
# =====================================================
SHUTDOWN_TIMEOUT=30000

